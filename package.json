{
  "name": "@kilden-io/expo",
  "version": "0.3.0",
  "description": "Kilden Expo / React Native SDK \u2014 client-side events, identity and feature flags.",
  "keywords": [
    "kilden",
    "analytics",
    "cdp",
    "events",
    "feature-flags",
    "expo",
    "react-native"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kildenhq/kilden-sdk-expo.git"
  },
  "homepage": "https://github.com/kildenhq/kilden-sdk-expo#readme",
  "bugs": "https://github.com/kildenhq/kilden-sdk-expo/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./dist/index.cjs",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "react-native": "./dist/react.cjs",
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx --format esm,cjs --dts --clean --target es2020 --external react --external react-native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'test/integration/**'",
    "check": "npm run typecheck && npm run test",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.21.0",
    "expo": ">=50.0.0",
    "expo-crypto": ">=13.0.0",
    "react-native": ">=0.73.0",
    "react": ">=18.0.0",
    "react-native-view-shot": ">=4.0.0",
    "jpeg-js": ">=0.4.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "expo": {
      "optional": true
    },
    "expo-crypto": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native-view-shot": {
      "optional": true
    },
    "jpeg-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "react": "^19.2.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
